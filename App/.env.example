# mock preserves the demonstration flow. api never falls back to demonstration services.
VITE_SERVICE_MODE=api
# Provide an HTTPS origin only after the backend environment has been agreed.
VITE_API_BASE_URL=
VITE_ALLOW_LOCAL_HEALTH_API=0
# 仅本机开发者工具/localhost调试可启用；使用真实业务账号，发布构建保持关闭。
VITE_LOCAL_BUSINESS_LOGIN=0

# Public mini-program AppID; injected into the WeChat build. Never put AppSecret here.
VITE_WECHAT_APPID=

# Commerce is a transaction backend for the WeChat business identity; API mode is required.
VITE_COMMERCE_MODE=api
VITE_COMMERCE_API_BASE_URL=http://127.0.0.1:18081
COMMERCE_PROXY_TARGET=http://127.0.0.1:18081
