# Server-side settings only. The session endpoint must be trusted and admin-controlled.
SHOP_AGENT_SESSION_URL=https://your-agent.example/api/auth/wechat/session
# Payment identity verification uses /api/auth/wechat/payment-identity on this same Agent origin.
# SHOP_WECHAT_APP_ID must match the Agent's WECHAT_APP_ID. No extra secret is exposed to the frontend.
SHOP_AGENT_CLIENT_ID=your-stable-agent-instance
# Local Docker Desktop only; keep disabled elsewhere.
SHOP_AGENT_ALLOW_DOCKER_HOST=0

SHOP_WECHAT_APP_ID=
SHOP_WECHAT_APP_SECRET=
SHOP_WECHAT_MCH_ID=
SHOP_WECHAT_API_V2_KEY=
SHOP_WECHAT_NOTIFY_URL=
SHOP_WECHAT_CERT_PATH=
SHOP_WECHAT_KEY_PATH=
SHOP_WECHAT_SANDBOX=false
