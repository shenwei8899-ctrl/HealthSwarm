<view class="index-page"><view class="home-header" style="{{(headerStyle)}}"><view class="home-navbar"><text class="home-navbar__title">首页</text></view><view data-event-opts="{{[['tap',[['goPage',['/pages/search/search']]]]]}}" class="home-search" bindtap="__e"><view class="home-search__icon"></view><text class="home-search__placeholder">请输入关键词搜索</text></view></view><block wx:if="{{$root.g0}}"><view class="hero-section"><swiper class="hero-swiper" circular="{{true}}" autoplay="{{true}}" interval="{{5000}}" duration="{{450}}" indicator-dots="{{true}}" indicator-color="rgba(255,255,255,.55)" indicator-active-color="#ffffff" data-event-opts="{{[['change',[['swiperChange',['$event']]]]]}}" bindchange="__e"><block wx:for="{{swiperList}}" wx:for-item="item" wx:for-index="index" wx:key="index"><swiper-item data-event-opts="{{[['tap',[['openPage',[index]]]]]}}" bindtap="__e"><image class="hero-image" src="{{item.image}}" mode="aspectFill"></image><block wx:if="{{item.title}}"><view class="hero-title">{{item.title}}</view></block></swiper-item></block></swiper></view></block><block wx:if="{{$root.g1}}"><view class="notice"><view class="notice__icon"><view class="notice__speaker"></view></view><swiper class="notice__swiper" vertical="{{true}}" circular="{{true}}" autoplay="{{true}}" interval="{{5000}}" duration="{{350}}"><block wx:for="{{noticeItems}}" wx:for-item="item" wx:for-index="index" wx:key="index"><swiper-item data-event-opts="{{[['tap',[['click',[index]]]]]}}" class="notice__item" bindtap="__e"><text class="notice__text">{{item.title}}</text></swiper-item></block></swiper><text class="notice__arrow">›</text></view></block><block wx:if="{{$root.g2}}"><view class="navigate-card"><swiper data-event-opts="{{[['change',[['change',['$event']]]]]}}" class="navigate-swiper" style="{{'height:'+(navigateHeight+'rpx')+';'}}" bindchange="__e"><block wx:for="{{navigatePages}}" wx:for-item="res" wx:for-index="key" wx:key="key"><swiper-item><view class="navigate-grid"><block wx:for="{{res}}" wx:for-item="item" wx:for-index="index" wx:key="index"><view data-event-opts="{{[['tap',[['grids',['$0'],[[['navigatePages','',key],['','',index]]]]]]]}}" class="navigate-item" bindtap="__e"><view class="navigate-icon-wrap"><image class="navigate-icon" src="{{item.image}}" mode="aspectFit"></image></view><text class="navigate-name">{{item.name}}</text></view></block></view></swiper-item></block></swiper><block wx:if="{{$root.g3>1}}"><view class="indicator-dots"><block wx:for="{{navigatePages}}" wx:for-item="res" wx:for-index="key" wx:key="key"><view class="{{['indicator-dots-item',current==key?'indicator-dots-active':'']}}"></view></block></view></block></view></block><view class="index-content"><view class="u-font-30 title"><text class="stroke"></text> 热门商品 </view><view class="hots-list"><block wx:for="{{hots}}" wx:for-item="item" wx:for-index="index" wx:key="index"><view data-event-opts="{{[['tap',[['goPage',['/pages/goods/detail?id='+item.id]]]]]}}" class="item" bindtap="__e"><view class="images"><image src="{{item.image}}" mode="aspectFill"></image></view><view class="content"><view class="u-p-15 name"><text class="u-line-2">{{item.title}}</text></view><view class="foot u-flex u-row-between u-tips-color"><view><text class="u-m-r-10">销量</text><text>{{item.sales}}</text></view><view><text class="u-m-r-10">浏览</text><text>{{item.views||0}}</text></view></view><view class="u-flex u-row-between u-p-15"><view class="price"><text>{{"￥"+item.price}}</text></view><text class="market_price u-tips-color">{{"￥"+item.marketprice}}</text></view></view></view></block><block wx:if="{{!$root.g4}}"><view class="u-flex u-row-center fa-empty u-p-b-60"><image src="../../static/image/data.png" mode></image><view class="u-tips-color">暂无更多的热门商品~</view></view></block></view></view><view class="index-content"><view class="u-font-30 title"><text class="stroke"></text> 推荐商品 </view><view class="goods-list"><block wx:for="{{recommends}}" wx:for-item="item" wx:for-index="index" wx:key="index"><view data-event-opts="{{[['tap',[['goPage',['/pages/goods/detail?id='+item.id]]]]]}}" class="item" bindtap="__e"><view class="images"><image src="{{item.image}}" mode="aspectFill"></image></view><view class="u-p-15 name"><text class="u-line-2">{{item.title}}</text></view><view class="foot u-flex u-row-between u-tips-color"><view><text class="u-m-r-10">销量</text><text>{{item.sales}}</text></view><view><text class="u-m-r-10">浏览</text><text>{{item.views||0}}</text></view></view><view class="u-flex u-row-between u-p-15"><view class="price"><text>{{"￥"+item.price}}</text></view><text class="market_price u-tips-color">{{"￥"+item.marketprice}}</text></view></view></block><block wx:if="{{!$root.g5}}"><view class="u-flex u-row-center fa-empty u-p-b-60"><image src="../../static/image/data.png" mode></image><view class="u-tips-color">暂无更多的推荐商品~</view></view></block></view><block wx:if="{{$root.g6}}"><view class="u-p-b-30"><u-loadmore vue-id="8dd740cc-1" status="{{has_more?status:'nomore'}}" bind:__l="__l"></u-loadmore></view></block></view><u-back-top vue-id="8dd740cc-2" scroll-top="{{scrollTop}}" icon-style="{{$root.a0}}" custom-style="{{$root.a1}}" bind:__l="__l"></u-back-top><block wx:if="{{$root.g7}}"><view class="home-tabbar-placeholder"></view></block><block wx:if="{{$root.g8}}"><view class="home-tabbar"><block wx:for="{{tabbarList}}" wx:for-item="item" wx:for-index="index" wx:key="index"><view data-event-opts="{{[['tap',[['switchTabbar',['$0'],[[['tabbarList','',index]]]]]]]}}" class="home-tabbar__item" bindtap="__e"><image class="home-tabbar__icon" src="{{index===0?item.selectedImage||item.image:item.image}}" mode="aspectFit"></image><text class="{{['home-tabbar__text',(index===0)?'home-tabbar__text--active':'']}}">{{item.text}}</text></view></block></view></block></view>