<view class="logistics-page data-v-510cbc80"><block wx:if="{{$root.g0}}"><view class="summary data-v-510cbc80"><view class="summary-title data-v-510cbc80">{{$root.g1+" 个物流包裹"}}</view><view class="summary-note data-v-510cbc80">不同供应商可能分开发货</view></view></block><block wx:for="{{$root.l0}}" wx:for-item="shipment" wx:for-index="__i0__" wx:key="id"><view class="shipment-card data-v-510cbc80"><view class="shipment-head u-flex u-row-between data-v-510cbc80"><view class="data-v-510cbc80"><view class="shipment-name data-v-510cbc80">{{shipment.$orig.shipper_name||'待分配物流'}}</view><view class="shipment-sn data-v-510cbc80">{{"包裹编号 "+shipment.$orig.shipment_sn}}</view></view><u-tag vue-id="{{'733399fd-1-'+__i0__}}" text="{{shipment.m0}}" type="{{shipment.m1}}" mode="plain" size="mini" class="data-v-510cbc80" bind:__l="__l"></u-tag></view><block wx:if="{{shipment.$orig.logistic_code}}"><view class="tracking-row u-flex u-row-between data-v-510cbc80"><view class="data-v-510cbc80"><view class="tracking-label data-v-510cbc80">物流单号</view><view class="tracking-code data-v-510cbc80">{{shipment.$orig.logistic_code}}</view></view><u-button vue-id="{{'733399fd-2-'+__i0__}}" size="mini" type="primary" plain="{{true}}" shape="circle" data-event-opts="{{[['^click',[['copyCode',['$0'],[[['shipments','id',shipment.$orig.id,'logistic_code']]]]]]]}}" bind:click="__e" class="data-v-510cbc80" bind:__l="__l" vue-slots="{{['default']}}">复制</u-button></view></block><block wx:if="{{shipment.$orig.shipping_at}}"><view class="shipment-time data-v-510cbc80">{{"发货时间 "+shipment.f0}}</view></block><view class="goods-list data-v-510cbc80"><block wx:for="{{shipment.$orig.items}}" wx:for-item="item" wx:for-index="__i1__" wx:key="order_goods_id"><view data-event-opts="{{[['tap',[['goGoods',['$0'],[[['shipments','id',shipment.$orig.id],['items','order_goods_id',item.order_goods_id,'goods_id']]]]]]]}}" class="goods-item u-flex data-v-510cbc80" bindtap="__e"><image src="{{item.image}}" mode="aspectFill" class="data-v-510cbc80"></image><view class="goods-content u-flex-1 data-v-510cbc80"><view class="goods-title u-line-2 data-v-510cbc80">{{item.title||'订单商品'}}</view><view class="goods-attr u-line-1 data-v-510cbc80">{{item.attrdata||''}}</view></view><view class="goods-quantity data-v-510cbc80">{{"×"+item.quantity}}</view></view></block></view></view></block><block wx:if="{{$root.g2}}"><view class="empty-state data-v-510cbc80"><u-empty vue-id="733399fd-3" text="暂无物流包裹" mode="car" class="data-v-510cbc80" bind:__l="__l"></u-empty></view></block><block wx:if="{{loading}}"><view class="page-loading u-flex u-row-center data-v-510cbc80"><u-loading vue-id="733399fd-4" mode="flower" size="70" class="data-v-510cbc80" bind:__l="__l"></u-loading></view></block></view>